+        const std::filesystem::path target = into / relative;
+        if (safe && type == '5') {
+            std::filesystem::create_directories(target, ec);
+        } else if (safe && (type == '0' || type == '\0')) {
+            std::filesystem::create_directories(target.parent_path(), ec);
+            std::ofstream out(target, std::ios::binary | std::ios::trunc);
+            std::uint64_t left = size;
+            while (left > 0 && in) {
+                const auto chunk = static_cast<std::streamsize>(std::min<std::uint64_t>(left, buffer.size()));
+                in.read(buffer.data(), chunk);
+                out.write(buffer.data(), in.gcount());
+                left -= static_cast<std::uint64_t>(in.gcount());
+            }
+            if (left != 0) return false;
+            ++files;
+            in.seekg(static_cast<std::streamoff>((512u - size % 512u) % 512u), std::ios::cur);
+            continue;
+        }
+        in.seekg(static_cast<std::streamoff>((size + 511u) / 512u * 512u), std::ios::cur);
+    }
+    std::printf("[android] unpacked %zu files from %s\n", files, tar.filename().c_str());
+    return true;
+}
+
+void use_external_storage() {
+    const char *external = SDL_GetAndroidExternalStoragePath();
+    if (external == nullptr) return;
+    const std::filesystem::path root(external);
+    std::error_code ec;
+    std::filesystem::create_directories(root / "import", ec);
+    std::filesystem::create_directories(root / "game" / "ms0" / "PSP" / "SAVEDATA", ec);
+    // Every step logged and nothing thrown out of here: this runs before the game, on SDL's thread.
+    try {
+        std::vector<std::filesystem::path> archives;
+        std::filesystem::directory_iterator it(root / "import", ec), end;
+        for (; !ec && it != end; it.increment(ec))
+            if (it->path().extension() == ".tar") archives.push_back(it->path());
+        if (ec) std::printf("[android] cannot list %s: %s\n", (root / "import").c_str(), ec.message().c_str());
+        for (const std::filesystem::path &archive : archives) {
+            std::printf("[android] unpacking %s\n", archive.c_str());
+            std::fflush(stdout);
+            if (unpack_tar(archive, root)) std::filesystem::remove(archive, ec);
+            else std::printf("[android] cannot unpack %s\n", archive.c_str());
+        }
+    } catch (const std::exception &e) {
+        std::printf("[android] unpacking the imports failed: %s\n", e.what());
+    }
+    // Test switches without a rebuild: KEY=VALUE lines in env.txt, set before anything reads them.
+    if (std::ifstream env(root / "env.txt"); env) {
+        std::string line;
+        while (std::getline(env, line)) {
+            const std::size_t equals = line.find('=');
+            if (line.empty() || line[0] == '#' || equals == std::string::npos) continue;
+            setenv(line.substr(0, equals).c_str(), line.substr(equals + 1).c_str(), 1);
+            std::printf("[android] env.txt: %s\n", line.c_str());
+        }
+    }
+    setenv(portablekit::env_name("DATA_DIR").c_str(), root.c_str(), 0);
+    const std::filesystem::path game = root / "game";
+    if (std::filesystem::is_regular_file(game / "disc.iso", ec) &&
+        std::filesystem::is_regular_file(game / "EBOOT.ELF", ec))
+        setenv(portablekit::env_name("GAME_DIR").c_str(), game.c_str(), 0);
+    std::printf("[android] data in %s, game %s\n", root.c_str(),
+                std::getenv(portablekit::env_name("GAME_DIR").c_str()) != nullptr ? "found" : "not there yet");
+    std::fflush(stdout);
+}
+#endif
+
 } // namespace
 
 int main(int argc, char *argv[]) {
     redirect_output();
+#if defined(PORTABLEKIT_ANDROID_EXTERNAL_DATA)
+    use_external_storage();
+#endif
     // Back opens the in-game menu instead of leaving the app.
     SDL_SetHint(SDL_HINT_ANDROID_TRAP_BACK_BUTTON, "1");
     unpack_bundled_fonts();
